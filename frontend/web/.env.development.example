# 【开发】环境变量 - 覆盖通用配置（案例）

# 环境标识
VITE_APP_ENV = dev

# 项目名称
VITE_APP_TITLE = FastapiAdmin

# 浏览器侧同源前缀（与 Vite 代理配合时用 /，请求走 localhost:端口 + 代理）
VITE_API_URL = /

# 代理目标：本机后端
VITE_API_BASE_URL = http://127.0.0.1:8001

# 是否删除控制台输出
VITE_DROP_CONSOLE = false

# 实时服务基址（监控与传输 SSE 使用；生产配置为对应后端地址）
VITE_APP_WS_ENDPOINT = ws://localhost:8001
